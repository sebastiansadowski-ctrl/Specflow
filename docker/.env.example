# Skopiuj do docker/.env i uzupełnij (docker/.env jest w .gitignore).

# Hasło do API serwera OpenCode (tylko w sieci wewnętrznej laboratorium).
# Wygeneruj: openssl rand -hex 24
OPENCODE_SERVER_PASSWORD=

# UID/GID właściciela repo na serwerze (wynik `id -u` i `id -g`),
# żeby pliki tworzone w kontenerze lab miały właściwego właściciela.
# Ten sam UID w kontenerach Specflow, OpenCode i lab - wszyscy mogą zmieniać pliki projektów.
AGENT_UID=1000
AGENT_GID=1000

# Port interfejsu Specflow na 127.0.0.1 (tylko localhost; na serwerze przez tunel SSH).
SPECFLOW_PORT=8000
