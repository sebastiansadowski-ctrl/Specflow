# Przykładowe ustawienia Specflow (skopiuj do .env). Argumenty CLI mają pierwszeństwo.
SPECFLOW_HARNESS=mock                 # mock | opencode
SPECFLOW_DATA_DIR=var                 # baza SQLite i workspace'y projektów
# SPECFLOW_PORT=8000
# SPECFLOW_OPENCODE_URL=http://127.0.0.1:4096
# SPECFLOW_OPENCODE_PASSWORD=
# SPECFLOW_MOCK_STEP_DELAY_S=0.4      # tempo demo
# SPECFLOW_SHUTDOWN_GRACE_S=20
